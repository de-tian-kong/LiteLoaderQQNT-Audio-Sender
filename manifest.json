{
    "manifest_version": 4,
    "type": "extension",
    "name": "音频发送",
    "slug": "audio_sender",
    "description": "支持拖拽发送音频文件到聊天窗口。",
    "version": "0.0.3",
    "icon": "./icon.png",
    "authors": [
        {
            "name": "de-tian-kong",
            "link": "https://github.com/de-tian-kong"
        }
    ],
    "platform": [
        "win32",
        "linux",
        "darwin"
    ],
    "injects": {
        "renderer": "./src/renderer.js",
        "main": "./src/main.js",
        "preload": "./src/preload.js"
    },
    "repository": {
        "repo": "de-tian-kong/LiteLoaderQQNT-Audio-Sender",
        "branch": "main",
        "release": {
            "tag": "0.0.3"
        }
    }
}
